[Unit]
Description=KAROKA Présences (bot Telegram + dashboard)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=karoka
WorkingDirectory=/opt/karoka
ExecStart=/opt/karoka/venv/bin/python tracker.py
# Redémarre toujours (plantage, coupure réseau), 5 s après
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# Serveur partagé : plafonner la mémoire (usage normal ≈ 85 Mo). Si le plafond est
# dépassé, seul CE service est tué puis relancé ; les autres services ne sont pas touchés.
MemoryHigh=300M
MemoryMax=450M
MemorySwapMax=0
OOMScoreAdjust=500
# Durcissement
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
